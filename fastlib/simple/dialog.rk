# dialog.rk — common dialogs collected behind one module.
#
# A dialog either shows a message, asks a yes/no question, offers a path, or
# accepts a colour name. Everything is plain Rusk code over the core primaries.

import "messagebox"
import "filedialog"
import "colorchooser"

to simple_dialog_message with text as view of text:
    simple_message_info with text

to simple_dialog_warn with text as view of text:
    simple_message_warn with text

to simple_dialog_error with text as view of text:
    simple_message_error with text

to simple_dialog_question with text as view of text:
    give back simple_message_ask with text

to simple_dialog_open with path as text and question as view of text:
    give back simple_file_open_pick with path and question

to simple_dialog_save with path as text:
    give back simple_file_save_pick with path

to simple_dialog_color with name as view of text:
    give back simple_color_pick with name
