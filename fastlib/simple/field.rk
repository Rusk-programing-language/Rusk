# field.rk — single-line edit fields.

import "core"
import "control"
import "constants"
import "geometry"

to simple_field with window as a number and text as view of text and x as a number and y as a number and width as a number and height as a number:
    give back simple_field_new with window and text and x and y and width and height

to simple_field_at with window as a number and text as view of text and rect as a view of a list of numbers:
    give back simple_field_new with window and text and (item 1 of rect) and (item 2 of rect) and (item 3 of rect) and (item 4 of rect)

to simple_field_value with field as a number:
    give back simple_control_text with field

to simple_field_set_value with field as a number and text as view of text:
    simple_control_set_text with field and text

to simple_field_clear with field as a number:
    simple_control_set_text with field and ""

to simple_field_changed with field as a number:
    give back simple_control_is with field and simple_event_change

to simple_field_append with field as a number and suffix as view of text:
    let current be simple_control_text with field
    simple_control_set_text with field and (current + suffix)

# Present a field as a row of mask characters without changing its real text.
to simple_field_masked with field as a number and mask as view of text:
    simple_control_mask with field and mask
