    give back out

# Case-insensitive prefix check.
to db_starts_with_ci with text as a view of text and prefix as a view of text:
    let upper be text_upper with text
    give back text_starts_with with upper and (text_upper with prefix)

# Remove duplicate text items, keeping the first occurrence.
to db_unique_text with items as a view of a list of text:
    let out be an empty list of text
    for each item_text in items:
        let seen be false
        for each kept in out:
            if kept is item_text:
                set seen to true
        if not seen:
            add (copy of item_text) to out
    give back out

# Keep names starting with `prefix`, add a trailing space, dedupe, and sort.
to db_filter_completions with candidates as a view of a list of text and prefix as a view of text:
    let matches be an empty list of text
    for each candidate in candidates:
        if db_starts_with_ci with candidate and prefix:
            let completion be copy of candidate
            let n be length of completion
            if n is at least 1:
                if (letter n of completion) is not " ":
                    set completion to completion + " "
            add completion to matches
    give back fs_sort with (db_unique_text with matches)
