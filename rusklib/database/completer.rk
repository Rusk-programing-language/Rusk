    add "SELECT" to out
    add "SET" to out
    add "TABLE" to out
    add "TEMP" to out
    add "TEMPORARY" to out
    add "THEN" to out
    add "TIES" to out
    add "TO" to out
    add "TRANSACTION" to out
    add "TRIGGER" to out
    add "UNBOUNDED" to out
    add "UNION" to out
    add "UNIQUE" to out
    add "UPDATE" to out
    add "USING" to out
    add "VACUUM" to out
