#!/bin/sh
# toastset — the Rusk toolchain installer.
#
# Install the latest Rusk release:
#
#   curl --proto '=https' --tlsv1.2 -sSf \
#     https://raw.githubusercontent.com/Rusk-programing-language/Rusk/main/toastset | sh
#
# Running it again replaces an existing installation with the requested or
# latest version, in place.
#
# Pick a version, target, or installation directory:
#
#   sh toastset --version 1.1.2
#   sh toastset --target aarch64-unknown-linux-musl
#   sh toastset --bin-dir "$HOME/.local/bin"
#
# Termux and other musl-based systems get a statically linked build, so the
# installed binary does not depend on the system's C library. Windows runs the
# script from Git Bash, MSYS2, or Cygwin and installs rusk.exe.
#
# Unless --no-modify-path or an explicit --bin-dir is used, toastset also adds
# its bin directory to the shell profile and, on Windows, to the user PATH.
#
# Environment:
#   TOASTSET_VERSION   release to install (default: latest)
#   TOASTSET_TARGET    release target (default: detected)
#   TOASTSET_HOME      toolchain home (default: $HOME/.toastset)
#   TOASTSET_BIN_DIR   where to put the `rusk` binary
#   TOASTSET_NO_MODIFY_PATH=1
#                      do not edit a shell profile or the Windows PATH
#
# Rusk is distributed under the MIT license.

set -eu

REPO="Rusk-programing-language/Rusk"
BASE_URL="${TOASTSET_DOWNLOAD_BASE:-https://github.com/${REPO}/releases/download}"
API_URL="${TOASTSET_API_URL:-https://api.github.com/repos/${REPO}/releases/latest}"

VERSION="${TOASTSET_VERSION:-}"
TARGET="${TOASTSET_TARGET:-}"
TOASTSET_HOME="${TOASTSET_HOME:-$HOME/.toastset}"
BIN_DIR="${TOASTSET_BIN_DIR:-}"
VERIFY=1
MODIFY_PATH=1
EXPLICIT_BIN_DIR=0
PATH_UPDATED=0
PATH_PROFILE=""
[ -n "${TOASTSET_BIN_DIR:-}" ] && EXPLICIT_BIN_DIR=1
[ "${TOASTSET_NO_MODIFY_PATH:-0}" = "1" ] && MODIFY_PATH=0

# The download bar only uses color when stderr is a terminal and the user has
# not asked for plain output.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    BAR_ORANGE="$(printf '\033[38;5;208m')"
    BAR_RESET="$(printf '\033[0m')"
else
    BAR_ORANGE=""
    BAR_RESET=""
fi
CURSOR_HIDDEN=0

say() { printf '%s\n' "$*"; }
info() { printf 'toastset: %s\n' "$*"; }
warn() { printf 'toastset: warning: %s\n' "$*" >&2; }
die() {
    printf 'toastset: error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
toastset — install the Rusk compiler and toolchain

USAGE:
  toastset [OPTIONS]

OPTIONS:
  --version VERSION   install a specific release (for example 1.1.2)
  --target TARGET     install a specific target:
                        x86_64-unknown-linux-gnu   aarch64-unknown-linux-gnu
                        x86_64-unknown-linux-musl  aarch64-unknown-linux-musl
                        x86_64-pc-windows-msvc
  --home DIR          toolchain home (default: $HOME/.toastset)
  --bin-dir DIR       install the `rusk` binary into DIR
  --no-verify         skip SHA-256 verification
  --no-modify-path    do not edit a shell or Windows PATH setting
  --uninstall         remove a previous toastset installation
  -h, --help          show this help

Termux, Alpine, and other musl-based systems automatically get the static
musl build, which runs without the glibc loader. Windows users should run this
script from Git Bash, MSYS2, or Cygwin; it installs rusk.exe and updates both
the shell profile and the Windows user PATH.

If Rusk is already installed, toastset replaces it with the requested or
latest version (an in-place upgrade).

EXAMPLES:
  sh toastset
  sh toastset --version 1.1.2 --bin-dir "$HOME/.local/bin"

The script works when piped from curl:
  curl --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/Rusk-programing-language/Rusk/main/toastset | sh
EOF
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "I need '$1' but it isn't installed"
}

fetch() {
    url="$1"
    out="$2"
    progress="${3:-quiet}"
    if command -v curl >/dev/null 2>&1; then
        if [ "$progress" = "bar" ] && [ -t 2 ]; then
            # curl draws its progress bar on stderr, so it stays out of piped
            # output while still being visible in a terminal.
            curl --proto '=https' --tlsv1.2 -fL --progress-bar "$url" -o "$out"
        else
            curl --proto '=https' --tlsv1.2 -fsSL "$url" -o "$out"
        fi
    elif command -v wget >/dev/null 2>&1; then
        if [ "$progress" = "bar" ] && [ -t 2 ]; then
            wget -q --show-progress "$url" -O "$out"
        else
            wget -q "$url" -O "$out"
        fi
    else
        die "I need curl or wget to download Rusk"
    fi
}

download() {
    fetch "$1" "$2" quiet
}

# Draw one step of the block-style download bar on stderr. Kept POSIX so it
# works in Termux's busybox ash as well as bash, dash, and zsh.
print_progress() {
    bar_bytes="$1"
    bar_total="$2"
    [ "$bar_total" -gt 0 ] || return 0

    bar_width=50
    bar_percent=$(( bar_bytes * 100 / bar_total ))
    if [ "$bar_percent" -gt 100 ]; then
        bar_percent=100
    fi
    bar_on=$(( bar_percent * bar_width / 100 ))
    bar_off=$(( bar_width - bar_on ))

    bar_filled=""
    bar_i=0
    while [ "$bar_i" -lt "$bar_on" ]; do
        bar_filled="${bar_filled}■"
        bar_i=$(( bar_i + 1 ))
    done
    bar_empty=""
    bar_i=0
    while [ "$bar_i" -lt "$bar_off" ]; do
        bar_empty="${bar_empty}･"
        bar_i=$(( bar_i + 1 ))
    done

    printf '\r%s%s%s %3d%%%s' \
        "$BAR_ORANGE" "$bar_filled" "$bar_empty" "$bar_percent" "$BAR_RESET" >&4
}

# Poll the growing download file so the bar updates smoothly without making
# the renderer depend on how many bytes arrive at once.
download_with_progress() {
    dl_url="$1"
    dl_output="$2"

    # Windows shells and non-terminal output keep the plain curl/wget bar.
    if is_windows || [ ! -t 2 ]; then
        if ! fetch "$dl_url" "$dl_output" bar; then
            return 1
        fi
        return 0
    fi

    dl_headers="${dl_output}.headers"
    exec 4>&2
    printf '\033[?25l' >&2
    CURSOR_HIDDEN=1

    if command -v curl >/dev/null 2>&1; then
        curl --proto '=https' --tlsv1.2 -fsL -D "$dl_headers" -o "$dl_output" "$dl_url" &
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$dl_url" -O "$dl_output" &
    else
        printf '\033[?25h' >&2
        CURSOR_HIDDEN=0
        exec 4>&-
        die "I need curl or wget to download Rusk"
    fi
    dl_pid=$!

    while kill -0 "$dl_pid" 2>/dev/null; do
        if [ -f "$dl_output" ]; then
            dl_total=0
            if [ -f "$dl_headers" ]; then
                dl_total="$(grep -i '^content-length:' "$dl_headers" 2>/dev/null | tail -n 1 | tr -dc '0-9')"
            fi
            dl_so_far="$(ls -ln "$dl_output" 2>/dev/null | awk '{print $5}')"
            [ -n "$dl_so_far" ] || dl_so_far=0
            print_progress "$dl_so_far" "${dl_total:-0}"
        fi
        sleep 0.1 2>/dev/null || sleep 1
    done

    dl_status=0
    wait "$dl_pid" || dl_status=$?

    if [ "$dl_status" -eq 0 ] && [ -f "$dl_output" ]; then
        dl_so_far="$(ls -ln "$dl_output" | awk '{print $5}')"
        print_progress "$dl_so_far" "$dl_so_far"
    fi
    printf '\n' >&4
    exec 4>&-
    if [ "$CURSOR_HIDDEN" = "1" ]; then
        printf '\033[?25h' >&2
        CURSOR_HIDDEN=0
    fi
    rm -f "$dl_headers"
    return "$dl_status"
}

latest_version() {
    tmp="$(mktemp "${TMPDIR:-/tmp}/toastset-latest.XXXXXX")"
    if ! download "$API_URL" "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        die "I couldn't reach GitHub to find the latest release; pass --version"
    fi
    version="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' "$tmp" | head -n 1)"
    rm -f "$tmp"
    [ -n "$version" ] || die "I couldn't read the latest release from GitHub; pass --version"
    printf '%s\n' "$version"
}

is_windows() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MINGW* | MSYS* | CYGWIN* | Windows_NT) return 0 ;;
    esac
    return 1
}

windows_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        printf '%s\n' "$1"
    fi
}

is_termux() {
    [ -n "${TERMUX_VERSION:-}" ] && return 0
    case "${PREFIX:-}" in *com.termux*) return 0 ;; esac
    case "${HOME:-}" in *com.termux*) return 0 ;; esac
    [ -d /data/data/com.termux/files/usr ] && return 0
    return 1
}

is_musl_system() {
    is_termux && return 0
    [ -f /etc/alpine-release ] && return 0
    if command -v ldd >/dev/null 2>&1; then
        ldd --version 2>&1 | grep -qi musl && return 0
    fi
    return 1
}

detect_target() {
    os="$(uname -s 2>/dev/null || echo unknown)"
    arch="$(uname -m 2>/dev/null || echo unknown)"
    case "$os" in
        Linux)
            if is_musl_system; then
                libc="musl"
            else
                libc="gnu"
            fi
            case "$arch" in
                x86_64 | amd64) printf '%s\n' "x86_64-unknown-linux-${libc}" ;;
                aarch64 | arm64) printf '%s\n' "aarch64-unknown-linux-${libc}" ;;
                *) die "Rusk doesn't have a build for this machine ($arch)" ;;
            esac
            ;;
        MINGW* | MSYS* | CYGWIN* | Windows_NT)
            case "$arch" in
                x86_64 | amd64) printf '%s\n' "x86_64-pc-windows-msvc" ;;
                *) die "Rusk doesn't have a Windows build for this machine ($arch)" ;;
            esac
            ;;
        *) die "Rusk currently ships for Linux and Windows (found $os)" ;;
    esac
}

path_line() {
    printf 'export PATH="%s:$PATH"' "$BIN_DIR"
}

add_path_to() {
    profile="$1"
    if grep -F -q "$BIN_DIR" "$profile" 2>/dev/null; then
        PATH_UPDATED=1
        PATH_PROFILE="${PATH_PROFILE:-$profile}"
        return 0
    fi
    if {
        printf '\n# Added by toastset (Rusk)\n'
        path_line
        printf '\n'
    } >>"$profile" 2>/dev/null; then
        info "added $BIN_DIR to PATH in $profile"
        PATH_UPDATED=1
        PATH_PROFILE="${PATH_PROFILE:-$profile}"
    else
        warn "I couldn't update $profile; add $BIN_DIR to PATH yourself"
    fi
}

add_to_profile() {
    [ "$MODIFY_PATH" = "1" ] || return 0
    [ "$EXPLICIT_BIN_DIR" = "1" ] && return 0

    # Login shells read .profile, but Termux and many desktop terminals start
    # an interactive shell that only reads .bashrc (or .zshrc). Update both so
    # `rusk` is found in the next shell, not just after a manual export.
    add_path_to "$HOME/.profile"
    case "${SHELL:-}" in
        *zsh*) add_path_to "$HOME/.zshrc" ;;
        *) add_path_to "$HOME/.bashrc" ;;
    esac
    # Also update the other shell's rc file when the user clearly has one, so
    # switching between bash and zsh keeps finding rusk.
    if [ -e "$HOME/.zshrc" ]; then
        add_path_to "$HOME/.zshrc"
    fi
    if [ -e "$HOME/.bashrc" ]; then
        add_path_to "$HOME/.bashrc"
    fi
    if [ -e "$HOME/.bash_profile" ]; then
        add_path_to "$HOME/.bash_profile"
    fi
    if [ -e "$HOME/.zprofile" ]; then
        add_path_to "$HOME/.zprofile"
    fi
    return 0
}

add_to_windows_path() {
    is_windows || return 0
    [ "$MODIFY_PATH" = "1" ] || return 0
    [ "$EXPLICIT_BIN_DIR" = "1" ] && return 0

    if command -v powershell.exe >/dev/null 2>&1; then
        ps="powershell.exe"
    elif command -v pwsh >/dev/null 2>&1; then
        ps="pwsh"
    else
        warn "I couldn't find PowerShell; add the Rusk bin directory to PATH yourself"
        return 0
    fi

    win_bin="$(windows_path "$BIN_DIR")"
    result="$(TOASTSET_WIN_BIN="$win_bin" "$ps" -NoProfile -NonInteractive -Command "\$p=[string][Environment]::GetEnvironmentVariable('Path','User'); \$b=\$env:TOASTSET_WIN_BIN; if ((\$p -split ';') -contains \$b) { 'present' } else { if (\$p) { \$p=\$p.TrimEnd([char]';')+';'+\$b } else { \$p=\$b }; [Environment]::SetEnvironmentVariable('Path',\$p,'User'); 'added' }" 2>/dev/null | tr -d '\r')" || result=""
    case "$result" in
        added)
            info "added $win_bin to the Windows user PATH"
            PATH_UPDATED=1
            PATH_PROFILE="${PATH_PROFILE:-the Windows user PATH}"
            ;;
        present)
            PATH_UPDATED=1
            PATH_PROFILE="${PATH_PROFILE:-the Windows user PATH}"
            ;;
        *)
            warn "I couldn't update the Windows user PATH; add $win_bin yourself"
            ;;
    esac
}

uninstall() {
    [ -n "$BIN_DIR" ] || BIN_DIR="$TOASTSET_HOME/bin"
    rm -f "$BIN_DIR/rusk" "$BIN_DIR/rusk.exe"
    rm -rf "$TOASTSET_HOME"
    info "removed Rusk from $BIN_DIR and $TOASTSET_HOME"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --version)
            [ "$#" -ge 2 ] || die "--version needs a value"
            VERSION="${2#v}"
            shift 2
            ;;
        --target)
            [ "$#" -ge 2 ] || die "--target needs a value"
            TARGET="$2"
            shift 2
            ;;
        --home)
            [ "$#" -ge 2 ] || die "--home needs a value"
            TOASTSET_HOME="$2"
            shift 2
            ;;
        --bin-dir)
            [ "$#" -ge 2 ] || die "--bin-dir needs a value"
            BIN_DIR="$2"
            EXPLICIT_BIN_DIR=1
            shift 2
            ;;
        --no-verify) VERIFY=0; shift ;;
        --no-modify-path) MODIFY_PATH=0; shift ;;
        --uninstall) uninstall; exit 0 ;;
        -h | --help) usage; exit 0 ;;
        *) die "I don't know '$1' — run 'toastset --help'" ;;
    esac
done

if [ -z "$BIN_DIR" ]; then
    BIN_DIR="$TOASTSET_HOME/bin"
fi

[ -n "$TARGET" ] || TARGET="$(detect_target)"
case "$TARGET" in
    x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | \
        x86_64-unknown-linux-musl | aarch64-unknown-linux-musl | \
        x86_64-pc-windows-msvc) ;;
    *) die "unknown target '$TARGET'" ;;
esac
case "$TARGET" in
    *-windows-*) EXE=".exe" ;;
    *) EXE="" ;;
esac

# A previous install can be replaced in place. Remember what it was so the
# upgrade is visible in the output.
PREVIOUS_VERSION=""
if [ -f "$TOASTSET_HOME/version" ]; then
    PREVIOUS_VERSION="$(cat "$TOASTSET_HOME/version" 2>/dev/null || true)"
elif [ -f "$BIN_DIR/rusk$EXE" ]; then
    PREVIOUS_VERSION="$("$BIN_DIR/rusk$EXE" version 2>/dev/null | head -n 1 || true)"
fi
if [ -f "$BIN_DIR/rusk$EXE" ]; then
    EXISTING=1
else
    EXISTING=0
    if [ -n "$PREVIOUS_VERSION" ]; then
        EXISTING=1
    fi
fi

if [ -z "$VERSION" ]; then
    info "looking up the latest Rusk release"
    VERSION="$(latest_version)"
fi

name="rusk-v${VERSION}-${TARGET}"
archive="${name}.tar.gz"
url="${BASE_URL}/v${VERSION}/${archive}"

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/toastset.XXXXXX")"
cleanup() {
    if [ "${CURSOR_HIDDEN:-0}" = "1" ]; then
        printf '\033[?25h' >&2 2>/dev/null || true
    fi
    rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM

info "downloading Rusk ${VERSION} for ${TARGET}"
if ! download_with_progress "$url" "$tmpdir/$archive"; then
    case "$TARGET" in
        *-musl)
            die "I couldn't download $url — release ${VERSION} may not have a static musl build yet; try a newer --version or leave --version off"
            ;;
        *)
            die "I couldn't download $url"
            ;;
    esac
fi

if [ "$VERIFY" = "1" ]; then
    if download "${BASE_URL}/v${VERSION}/SHA256SUMS" "$tmpdir/SHA256SUMS" 2>/dev/null; then
        expected="$(sed -n "s/^\([0-9a-fA-F]*\)[[:space:]][[:space:]]*.*${archive}$/\1/p" "$tmpdir/SHA256SUMS" | head -n 1)"
        if [ -n "$expected" ]; then
            if command -v sha256sum >/dev/null 2>&1; then
                actual="$(sha256sum "$tmpdir/$archive" | awk '{print $1}')"
            elif command -v shasum >/dev/null 2>&1; then
                actual="$(shasum -a 256 "$tmpdir/$archive" | awk '{print $1}')"
            else
                warn "no sha256sum or shasum; skipping verification"
                actual="$expected"
            fi
            [ "$actual" = "$expected" ] || die "the download's checksum doesn't match"
            info "checksum verified"
        else
            warn "no checksum for $archive; continuing"
        fi
    else
        warn "SHA256SUMS isn't available; continuing without verification"
    fi
fi

tar -xzf "$tmpdir/$archive" -C "$tmpdir"
[ -f "$tmpdir/$name/rusk$EXE" ] || die "the archive didn't contain rusk$EXE"

mkdir -p "$BIN_DIR"

# Install beside the destination and rename into place. Renaming replaces a
# binary that is still running, where writing through it would fail.
staged="$BIN_DIR/.rusk.toastset.$$$EXE"
cp "$tmpdir/$name/rusk$EXE" "$staged" || die "I couldn't copy rusk to $BIN_DIR"
chmod 755 "$staged" 2>/dev/null || true
mv -f "$staged" "$BIN_DIR/rusk$EXE"

# Keep a copy of the installer for `toastset --uninstall` and upgrades.
mkdir -p "$TOASTSET_HOME/bin"
cp "$tmpdir/$name/toastset" "$TOASTSET_HOME/bin/toastset" 2>/dev/null || true
chmod 755 "$TOASTSET_HOME/bin/toastset" 2>/dev/null || true
printf '%s\n' "$VERSION" >"$TOASTSET_HOME/version"

add_to_profile
add_to_windows_path

if [ "$EXISTING" = "1" ]; then
    if [ -n "$PREVIOUS_VERSION" ] && [ "$PREVIOUS_VERSION" != "$VERSION" ]; then
        info "reinstalled rusk $VERSION to $BIN_DIR/rusk$EXE (was $PREVIOUS_VERSION)"
    else
        info "reinstalled rusk $VERSION to $BIN_DIR/rusk$EXE"
    fi
else
    info "installed rusk $VERSION to $BIN_DIR/rusk$EXE"
fi
case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
        say ""
        if [ "$PATH_UPDATED" = "1" ]; then
            say "Rusk is set up on your PATH for new shells."
            [ -n "$PATH_PROFILE" ] && say "  updated: $PATH_PROFILE"
            say ""
            say "For this shell right now, run:"
        else
            say "Add Rusk to your PATH:"
        fi
        say "  $(path_line)"
        ;;
esac
say ""
say "Try it:"
say "  rusk version"
say "  rusk run examples/hello.rk"
