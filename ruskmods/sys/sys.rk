# sys.rk — small system helpers written in Rusk.
#
# Import it with `import "sys/sys"`. Everything here is built from the language
# primitives `environment`, `read file`, `file exists`, and `run command`.
# `run command` does not capture output, so helpers that need output read a
# small Linux file such as `/proc/...` or return only an exit status.

# A shell-quoted version of text, safe to paste into a `/bin/sh` command.
to sys_shell_quote with s as text:
    let out be "'"
    let i be 1
    let n be length of s
    while i is at most n:
        let ch be letter i of s
        if ch is "'":
            set out to out + "'\\''"
        otherwise:
            set out to out + ch
        set i to i + 1
    give back out + "'"

# True when the current account can read the path.
to sys_can_read with path as text:
    let status be run command ("test -r " + (sys_shell_quote with path) + " >/dev/null 2>&1")
    give back status is 0

# A number as decimal text.
to sys_number_text with n as a number:
    if n is 0:
        give back "0"
    let value be n
    let digits be ""
    while value is more than 0:
        let digit be value - (value / 10) * 10
        set digits to (letter (digit + 1) of "0123456789") + digits
        set value to value / 10
    give back digits

# Read a decimal number at the start of text. Stops at the first non-digit and
# gives 0 when there is no digit.
to sys_number_from_text with text as text:
    let n be length of text
    let i be 1
    while i is at most n and (letter i of text) is less than "0":
        set i to i + 1
    let value be 0
    while i is at most n and (letter i of text) is at most "9":
        let digit be 0
        let ch be letter i of text
        if ch is "0":
            set digit to 0
        otherwise if ch is "1":
            set digit to 1
        otherwise if ch is "2":
            set digit to 2
        otherwise if ch is "3":
            set digit to 3
        otherwise if ch is "4":
            set digit to 4
        otherwise if ch is "5":
            set digit to 5
        otherwise if ch is "6":
            set digit to 6
        otherwise if ch is "7":
            set digit to 7
        otherwise if ch is "8":
            set digit to 8
        otherwise if ch is "9":
            set digit to 9
        set value to value * 10 + digit
        set i to i + 1
    give back value

# An environment variable, or empty text when it is unset.
to sys_env with name as text:
    give back environment name

# The home directory from `HOME`, or empty text.
to sys_home:
    give back environment "HOME"

# The account name from `USER`, or empty text.
to sys_user:
    give back environment "USER"

# The login shell from `SHELL`, or empty text.
to sys_shell:
    give back environment "SHELL"

# The executable search path from `PATH`, or empty text.
to sys_search_path:
    give back environment "PATH"

# A temporary directory: `TMPDIR` when set, otherwise `/tmp`.
to sys_temp_dir:
    let dir be environment "TMPDIR"
    if length of dir is 0:
        give back "/tmp"
    give back dir

# True on Linux, where `/proc/self` exists.
to sys_is_linux:
    give back file exists "/proc/self"

# The kernel release from `/proc/sys/kernel/osrelease`, or empty text.
to sys_kernel:
    if sys_can_read with "/proc/sys/kernel/osrelease":
        give back read file "/proc/sys/kernel/osrelease"
    give back ""

# The machine host name from `/proc/sys/kernel/hostname`, or empty text.
to sys_hostname:
    if sys_can_read with "/proc/sys/kernel/hostname":
        give back read file "/proc/sys/kernel/hostname"
    give back ""

# An approximation of the operating system name.
to sys_os_name:
    if file exists "/proc/self":
        give back "linux"
    give back environment "OSTYPE"

# The number of processor entries in `/proc/cpuinfo`. Gives 0 when the file is
# missing.
to sys_cpu_count:
    if not sys_can_read with "/proc/cpuinfo":
        give back 0
    let text be read file "/proc/cpuinfo"
    let n be length of text
    let count be 0
    let at be 1
    while at is at most n:
        let line_start be at
        while at is at most n and letter at of text is not "\n":
            set at to at + 1
        let line be part line_start to (at - 1) of text
        if length of line is at least 9 and (part 1 to 9 of line) is "processor":
            set count to count + 1
        set at to at + 1
    give back count

# Total memory in KiB from `MemTotal:` in `/proc/meminfo`. Gives 0 when the file
# is missing or the line cannot be found.
to sys_memory_total_kb:
    if not sys_can_read with "/proc/meminfo":
        give back 0
    let text be read file "/proc/meminfo"
    let n be length of text
    let at be 1
    while at is at most n:
        let line_start be at
        while at is at most n and letter at of text is not "\n":
            set at to at + 1
        let line be part line_start to (at - 1) of text
        if length of line is at least 9 and (part 1 to 9 of line) is "MemTotal:":
            give back sys_number_from_text with (part 10 to (length of line) of line)
        set at to at + 1
    give back 0

# Whole seconds since boot, from `/proc/uptime`. Gives 0 when unavailable.
to sys_uptime_seconds:
    if not sys_can_read with "/proc/uptime":
        give back 0
    let text be read file "/proc/uptime"
    give back sys_number_from_text with text

# True when `name` names an executable on `PATH`.
to sys_command_exists with name as text:
    let status be run command ("command -v " + (sys_shell_quote with name) + " >/dev/null 2>&1")
    give back status is 0

# True when the path is a directory.
to sys_is_directory with path as text:
    let status be run command ("test -d " + (sys_shell_quote with path) + " >/dev/null 2>&1")
    give back status is 0

# True when the path is a regular file.
to sys_is_file with path as text:
    let status be run command ("test -f " + (sys_shell_quote with path) + " >/dev/null 2>&1")
    give back status is 0

# True when the account has root's user number.
to sys_is_root:
    let status be run command "test \"$(id -u)\" -eq 0 >/dev/null 2>&1"
    give back status is 0

# Run a shell command and give back its exit status. Output is shared with the
# program, just like the language's `run command` statement.
to sys_run with command_text as text:
    give back run command command_text

# Pause for a whole number of seconds. Negative values do nothing.
to sys_sleep with seconds as a number:
    if seconds is at most 0:
        give back 0
    let text be sys_number_text with seconds
    give back run command ("sleep " + text)
