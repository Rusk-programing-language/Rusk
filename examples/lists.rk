# Lists hold one kind of thing, and positions count from 1.

let loaves be [3, 6, 9]
say length of loaves        # 3
say item 2 of loaves        # 6

set item 2 of loaves to 12
say loaves                  # [3, 12, 9]

# A list has one owner at a time. `copy of` makes an independent list.
let same be copy of loaves
set item 1 of same to 0
say loaves                  # [3, 12, 9]
say same                    # [0, 12, 9]

let names be ["rye", "wheat", "spelt"]
for each name in names:
    say "one " + name + " loaf"

# An empty list needs its kind written down.
let empty be an empty list of numbers
say length of empty         # 0
say empty                   # []

# Lists may hold lists. Every sibling has the same shape.
let rows be [[1, 2], [3, 4], an empty list of numbers]
say rows                    # [[1, 2], [3, 4], []]
say item 2 of item 1 of rows  # 2
set item 1 of rows to [9, 8, 7]
add [5] to rows
say rows                    # [[9, 8, 7], [3, 4], [], [5]]

# `copy of` copies every level, so the copies are independent.
let spare be copy of rows
remove item 1 from spare
say rows                    # [[9, 8, 7], [3, 4], [], [5]]
say spare                   # [[3, 4], [], [5]]

let cube be [[[1, 2], [3]], [[4]]]
say cube                    # [[[1, 2], [3]], [[4]]]
